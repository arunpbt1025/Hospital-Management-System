class BillingSystem {
private:
    vector<Bill> bills;
    int nextBillId;

public:
    BillingSystem() {
        nextBillId = 1001;
    }

    void generateBill() {
        Bill b;

        b.billId = nextBillId++;

        b.patientId = getInt("Patient ID: ");

        b.roomCharges = getDouble("Room Charges: Rs. ");
        b.doctorCharges = getDouble("Doctor Charges: Rs. ");
        b.medicineCharges = getDouble("Medicine Charges: Rs. ");
        b.testCharges = getDouble("Test Charges: Rs. ");
        b.otherCharges = getDouble("Other Charges: Rs. ");

        b.total =
            b.roomCharges +
            b.doctorCharges +
            b.medicineCharges +
            b.testCharges +
            b.otherCharges;

        b.paymentStatus = "Pending";

        bills.push_back(b);

        cout << "\nBill generated successfully!\n";
        cout << "Bill ID: " << b.billId << endl;
        cout << fixed << setprecision(2);
        cout << "Total: Rs. " << b.total << endl;
    }

    void viewBill() {
        int id = getInt("Enter Bill ID: ");

        for (const Bill& b : bills) {

            if (b.billId == id) {

                line();
                cout << "                    BILL\n";
                line();

                cout << "Bill ID          : " << b.billId << endl;
                cout << "Patient ID       : " << b.patientId << endl;

                cout << fixed << setprecision(2);

                cout << "Room Charges     : Rs. "
                     << b.roomCharges << endl;

                cout << "Doctor Charges   : Rs. "
                     << b.doctorCharges << endl;

                cout << "Medicine Charges : Rs. "
                     << b.medicineCharges << endl;

                cout << "Test Charges     : Rs. "
                     << b.testCharges << endl;

                cout << "Other Charges    : Rs. "
                     << b.otherCharges << endl;

                cout << "-----------------------------\n";

                cout << "TOTAL            : Rs. "
                     << b.total << endl;

                cout << "Payment Status   : "
                     << b.paymentStatus << endl;

                line();

                return;
            }
        }

        cout << "Bill not found!\n";
    }

    void payment() {
        int id = getInt("Enter Bill ID: ");

        for (Bill& b : bills) {

            if (b.billId == id) {

                if (b.paymentStatus == "Paid") {
                    cout << "Bill is already paid.\n";
                    return;
                }

                b.paymentStatus = "Paid";

                cout << "Payment completed successfully.\n";
                return;
            }
        }

        cout << "Bill not found!\n";
    }

    double totalRevenue() {
        double revenue = 0;

        for (const Bill& b : bills) {
            if (b.paymentStatus == "Paid")
                revenue += b.total;
        }

        return revenue;
    }

    int countBills() {
        return static_cast<int>(bills.size());
    }
};

