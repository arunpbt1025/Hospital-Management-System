// ============================================================
//                    APPOINTMENT QUEUE
// ============================================================

struct Appointment {
    int appointmentId;
    int patientId;
    int doctorId;
    string date;
    string time;
    string status;
};

class AppointmentQueue {
private:
    queue<Appointment> q;
    int nextId;

public:
    AppointmentQueue() {
        nextId = 1;
    }

    void bookAppointment() {
        Appointment a;

        a.appointmentId = nextId++;

        a.patientId = getInt("Patient ID: ");
        a.doctorId = getInt("Doctor ID: ");
        a.date = getString("Date (DD/MM/YYYY): ");
        a.time = getString("Time: ");

        a.status = "Waiting";

        q.push(a);

        cout << "\nAppointment booked successfully!\n";
        cout << "Appointment ID: " << a.appointmentId << endl;
    }

    void viewAppointments() {
        if (q.empty()) {
            cout << "No appointments in queue.\n";
            return;
        }

        queue<Appointment> temp = q;

        line();
        cout << left
             << setw(8) << "ID"
             << setw(12) << "Patient"
             << setw(12) << "Doctor"
             << setw(15) << "Date"
             << setw(12) << "Time"
             << setw(15) << "Status" << endl;
        line();

        while (!temp.empty()) {
            Appointment a = temp.front();
            temp.pop();

            cout << left
                 << setw(8) << a.appointmentId
                 << setw(12) << a.patientId
                 << setw(12) << a.doctorId
                 << setw(15) << a.date
                 << setw(12) << a.time
                 << setw(15) << a.status << endl;
        }

        line();
    }

    void completeNextAppointment() {
        if (q.empty()) {
            cout << "No waiting appointments.\n";
            return;
        }

        Appointment a = q.front();
        q.pop();

        cout << "\nAppointment completed.\n";
        cout << "Appointment ID: " << a.appointmentId << endl;
        cout << "Patient ID: " << a.patientId << endl;
        cout << "Doctor ID: " << a.doctorId << endl;
    }

    int count() {
        return static_cast<int>(q.size());
    }
};

// ============================================================
//                  EMERGENCY PRIORITY QUEUE
// ============================================================

struct EmergencyPatient {
    int patientId;
    string name;
    int priority;
    string condition;

    bool operator<(const EmergencyPatient& other) const {
        return priority > other.priority;
    }
};

class EmergencyQueue {
private:
    priority_queue<EmergencyPatient> pq;

public:
    void addEmergencyPatient() {
        EmergencyPatient e;

        e.patientId = getInt("Patient ID: ");
        e.name = getString("Patient Name: ");
        e.condition = getString("Condition: ");

        cout << "\nPriority Level:\n";
        cout << "1. Critical\n";
        cout << "2. Serious\n";
        cout << "3. Normal\n";

        e.priority = getInt("Enter priority: ");

        if (e.priority < 1 || e.priority > 3) {
            cout << "Invalid priority. Setting to 3.\n";
            e.priority = 3;
        }

        pq.push(e);

        cout << "Emergency patient added successfully!\n";
    }

    void viewQueue() {
        if (pq.empty()) {
            cout << "Emergency queue is empty.\n";
            return;
        }

        priority_queue<EmergencyPatient> temp = pq;

        line();
        cout << left
             << setw(10) << "Patient"
             << setw(20) << "Name"
             << setw(12) << "Priority"
             << setw(25) << "Condition" << endl;
        line();

        while (!temp.empty()) {
            EmergencyPatient e = temp.top();
            temp.pop();

            string priorityName;

            if (e.priority == 1)
                priorityName = "CRITICAL";
            else if (e.priority == 2)
                priorityName = "SERIOUS";
            else
                priorityName = "NORMAL";

            cout << left
                 << setw(10) << e.patientId
                 << setw(20) << e.name
                 << setw(12) << priorityName
                 << setw(25) << e.condition
                 << endl;
        }

        line();
    }

    void treatNextPatient() {
        if (pq.empty()) {
            cout << "No emergency patients.\n";
            return;
        }

        EmergencyPatient e = pq.top();
        pq.pop();

        cout << "\nEmergency patient being treated:\n";
        cout << "Patient ID : " << e.patientId << endl;
        cout << "Name       : " << e.name << endl;
        cout << "Condition  : " << e.condition << endl;
    }

    int count() {
        return static_cast<int>(pq.size());
    }
};

