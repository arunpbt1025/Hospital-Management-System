struct MedicalRecord {
    int patientId;
    string date;
    string diagnosis;
    string prescription;
};

class MedicalHistory {
private:
    stack<MedicalRecord> history;

public:
    void addRecord() {
        MedicalRecord r;

        r.patientId = getInt("Patient ID: ");
        r.date = getString("Date: ");
        r.diagnosis = getString("Diagnosis: ");
        r.prescription = getString("Prescription: ");

        history.push(r);

        cout << "Medical record added successfully!\n";
    }

    void viewHistory() {
        if (history.empty()) {
            cout << "No medical records found.\n";
            return;
        }

        int patientId = getInt("Enter Patient ID: ");

        stack<MedicalRecord> temp = history;

        bool found = false;

        while (!temp.empty()) {
            MedicalRecord r = temp.top();
            temp.pop();

            if (r.patientId == patientId) {
                line();
                cout << "Patient ID    : " << r.patientId << endl;
                cout << "Date          : " << r.date << endl;
                cout << "Diagnosis     : " << r.diagnosis << endl;
                cout << "Prescription  : " << r.prescription << endl;
                line();

                found = true;
            }
        }

        if (!found)
            cout << "No history found for this patient.\n";
    }

    int count() {
        return static_cast<int>(history.size());
    }
};

