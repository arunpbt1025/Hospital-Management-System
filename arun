//                       PATIENT MODULE
// ============================================================

struct Patient {
    int id;
    string name;
    int age;
    string gender;
    string phone;
    string address;
    string bloodGroup;
    string disease;
    string doctor;
    bool admitted;

    Patient* next;

    Patient(int i, string n, int a, string g, string p,
            string addr, string bg, string d, string doc)
        : id(i), name(n), age(a), gender(g), phone(p),
          address(addr), bloodGroup(bg), disease(d),
          doctor(doc), admitted(false), next(nullptr) {}
};

class PatientList {
private:
    Patient* head;

public:
    PatientList() {
        head = nullptr;
    }

    ~PatientList() {
        Patient* current = head;

        while (current != nullptr) {
            Patient* temp = current;
            current = current->next;
            delete temp;
        }
    }

    Patient* searchById(int id) {
        Patient* current = head;

        while (current != nullptr) {
            if (current->id == id)
                return current;

            current = current->next;
        }

        return nullptr;
    }

    void addPatient() {
        line();
        cout << "                 REGISTER NEW PATIENT\n";
        line();

        int id = getInt("Patient ID: ");

        if (searchById(id) != nullptr) {
            cout << "Patient ID already exists!\n";
            return;
        }

        string name = getString("Name: ");
        int age = getInt("Age: ");
        string gender = getString("Gender: ");
        string phone = getString("Phone: ");
        string address = getString("Address: ");
        string blood = getString("Blood Group: ");
        string disease = getString("Disease/Problem: ");
        string doctor = getString("Assigned Doctor: ");

        Patient* newPatient =
            new Patient(id, name, age, gender, phone,
                        address, blood, disease, doctor);

        if (head == nullptr) {
            head = newPatient;
        } else {
            Patient* current = head;

            while (current->next != nullptr)
                current = current->next;

            current->next = newPatient;
        }

        cout << "\nPatient registered successfully!\n";
    }

    void displayPatient(Patient* p) {
        if (p == nullptr)
            return;

        line();
        cout << "Patient ID       : " << p->id << endl;
        cout << "Name             : " << p->name << endl;
        cout << "Age              : " << p->age << endl;
        cout << "Gender           : " << p->gender << endl;
        cout << "Phone            : " << p->phone << endl;
        cout << "Address          : " << p->address << endl;
        cout << "Blood Group      : " << p->bloodGroup << endl;
        cout << "Disease          : " << p->disease << endl;
        cout << "Doctor           : " << p->doctor << endl;
        cout << "Admission Status : "
             << (p->admitted ? "Admitted" : "Not Admitted") << endl;
        line();
    }

    void displayAll() {
        if (head == nullptr) {
            cout << "No patient records found.\n";
            return;
        }

        Patient* current = head;

        cout << "\n";
        line();
        cout << left
             << setw(8) << "ID"
             << setw(20) << "Name"
             << setw(6) << "Age"
             << setw(15) << "Gender"
             << setw(15) << "Blood"
             << setw(20) << "Disease" << endl;
        line();

        while (current != nullptr) {
            cout << left
                 << setw(8) << current->id
                 << setw(20) << current->name
                 << setw(6) << current->age
                 << setw(15) << current->gender
                 << setw(15) << current->bloodGroup
                 << setw(20) << current->disease
                 << endl;

            current = current->next;
        }

        line();
    }

    void searchPatient() {
        int id = getInt("Enter Patient ID: ");

        Patient* p = searchById(id);

        if (p == nullptr)
            cout << "Patient not found!\n";
        else
            displayPatient(p);
    }

    void updatePatient() {
        int id = getInt("Enter Patient ID to update: ");

        Patient* p = searchById(id);

        if (p == nullptr) {
            cout << "Patient not found!\n";
            return;
        }

        cout << "\nCurrent details:\n";
        displayPatient(p);

        p->phone = getString("New Phone: ");
        p->address = getString("New Address: ");
        p->disease = getString("New Disease: ");
        p->doctor = getString("New Doctor: ");

        cout << "Patient information updated successfully!\n";
    }

    void deletePatient() {
        int id = getInt("Enter Patient ID to delete: ");

        Patient* current = head;
        Patient* previous = nullptr;

        while (current != nullptr && current->id != id) {
            previous = current;
            current = current->next;
        }

        if (current == nullptr) {
            cout << "Patient not found!\n";
            return;
        }

        if (previous == nullptr)
            head = current->next;
        else
            previous->next = current->next;

        delete current;

        cout << "Patient deleted successfully!\n";
    }

    void admitPatient() {
        int id = getInt("Enter Patient ID: ");

        Patient* p = searchById(id);

        if (p == nullptr) {
            cout << "Patient not found!\n";
            return;
        }

        p->admitted = true;
        cout << "Patient marked as admitted.\n";
    }

    void dischargePatient() {
        int id = getInt("Enter Patient ID: ");

        Patient* p = searchById(id);

        if (p == nullptr) {
            cout << "Patient not found!\n";
            return;
        }

        p->admitted = false;
        cout << "Patient discharged successfully.\n";
    }

    int countPatients() {
        int count = 0;
        Patient* current = head;

        while (current != nullptr) {
            count++;
            current = current->next;
        }

        return count;
    }

    void sortByAge() {
        if (head == nullptr || head->next == nullptr) {
            cout << "Not enough patients to sort.\n";
            return;
        }

        bool swapped;

        do {
            swapped = false;
            Patient* current = head;

            while (current->next != nullptr) {
                if (current->age > current->next->age) {
                    swap(current->id, current->next->id);
                    swap(current->name, current->next->name);
                    swap(current->age, current->next->age);
                    swap(current->gender, current->next->gender);
                    swap(current->phone, current->next->phone);
                    swap(current->address, current->next->address);
                    swap(current->bloodGroup, current->next->bloodGroup);
                    swap(current->disease, current->next->disease);
                    swap(current->doctor, current->next->doctor);
                    swap(current->admitted, current->next->admitted);

                    swapped = true;
                }

                current = current->next;
            }

        } while (swapped);

        cout << "Patients sorted by age successfully.\n";
    }

    Patient* getHead() {
        return head;
    }
};

