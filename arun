struct Medicine {
    int id;
    string name;
    string category;
    double price;
    int quantity;
    string expiry;

    Medicine* next;

    Medicine(int i, string n, string c,
             double p, int q, string e)
        : id(i), name(n), category(c),
          price(p), quantity(q), expiry(e),
          next(nullptr) {}
};

class Pharmacy {
private:
    Medicine* head;

public:
    Pharmacy() {
        head = nullptr;
    }

    ~Pharmacy() {
        Medicine* current = head;

        while (current != nullptr) {
            Medicine* temp = current;
            current = current->next;
            delete temp;
        }
    }

    Medicine* searchMedicine(int id) {
        Medicine* current = head;

        while (current != nullptr) {
            if (current->id == id)
                return current;

            current = current->next;
        }

        return nullptr;
    }

    void addMedicine() {
        int id = getInt("Medicine ID: ");

        if (searchMedicine(id) != nullptr) {
            cout << "Medicine ID already exists!\n";
            return;
        }

        string name = getString("Medicine Name: ");
        string category = getString("Category: ");
        double price = getDouble("Price: ");
        int quantity = getInt("Quantity: ");
        string expiry = getString("Expiry Date: ");

        Medicine* m =
            new Medicine(id, name, category,
                         price, quantity, expiry);

        if (head == nullptr) {
            head = m;
        } else {
            Medicine* current = head;

            while (current->next != nullptr)
                current = current->next;

            current->next = m;
        }

        cout << "Medicine added successfully!\n";
    }

    void displayMedicines() {
        if (head == nullptr) {
            cout << "No medicines available.\n";
            return;
        }

        line();

        cout << left
             << setw(8) << "ID"
             << setw(20) << "Medicine"
             << setw(18) << "Category"
             << setw(12) << "Price"
             << setw(10) << "Stock"
             << setw(15) << "Expiry" << endl;

        line();

        Medicine* current = head;

        while (current != nullptr) {
            cout << left
                 << setw(8) << current->id
                 << setw(20) << current->name
                 << setw(18) << current->category
                 << setw(12) << fixed << setprecision(2)
                 << current->price
                 << setw(10) << current->quantity
                 << setw(15) << current->expiry
                 << endl;

            current = current->next;
        }

        line();
    }

    void search() {
        int id = getInt("Medicine ID: ");

        Medicine* m = searchMedicine(id);

        if (m == nullptr) {
            cout << "Medicine not found!\n";
            return;
        }

        cout << "\nMedicine Found\n";
        line();
        cout << "ID       : " << m->id << endl;
        cout << "Name     : " << m->name << endl;
        cout << "Category : " << m->category << endl;
        cout << "Price    : " << m->price << endl;
        cout << "Stock    : " << m->quantity << endl;
        cout << "Expiry   : " << m->expiry << endl;
        line();
    }

    void updateStock() {
        int id = getInt("Medicine ID: ");

        Medicine* m = searchMedicine(id);

        if (m == nullptr) {
            cout << "Medicine not found!\n";
            return;
        }

        int quantity = getInt("New quantity: ");

        if (quantity < 0) {
            cout << "Invalid quantity!\n";
            return;
        }

        m->quantity = quantity;

        cout << "Stock updated successfully!\n";
    }

    void sellMedicine() {
        int id = getInt("Medicine ID: ");

        Medicine* m = searchMedicine(id);

        if (m == nullptr) {
            cout << "Medicine not found!\n";
            return;
        }

        int qty = getInt("Quantity to sell: ");

        if (qty <= 0 || qty > m->quantity) {
            cout << "Invalid quantity / insufficient stock!\n";
            return;
        }

        double total = qty * m->price;

        m->quantity -= qty;

        cout << fixed << setprecision(2);
        cout << "Medicine sold successfully.\n";
        cout << "Total Amount: Rs. " << total << endl;
        cout << "Remaining Stock: " << m->quantity << endl;
    }

    void lowStock() {
        if (head == nullptr) {
            cout << "No medicines available.\n";
            return;
        }

        Medicine* current = head;
        bool found = false;

        line();
        cout << "LOW STOCK MEDICINES\n";
        line();

        while (current != nullptr) {
            if (current->quantity <= 10) {
                cout << "ID: " << current->id
                     << " | " << current->name
                     << " | Stock: " << current->quantity
                     << endl;

                found = true;
            }

            current = current->next;
        }

        if (!found)
            cout << "No low-stock medicines.\n";

        line();
    }

    int count() {
        int count = 0;
        Medicine* current = head;

        while (current != nullptr) {
            count++;
            current = current->next;
        }

        return count;
    }
};

