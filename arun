// ============================================================

struct Room {
    int roomNumber;
    bool occupied;
    int patientId;
};

class RoomManager {
private:
    static const int TOTAL_ROOMS = 20;
    Room rooms[TOTAL_ROOMS];

public:
    RoomManager() {
        for (int i = 0; i < TOTAL_ROOMS; i++) {
            rooms[i].roomNumber = 101 + i;
            rooms[i].occupied = false;
            rooms[i].patientId = -1;
        }
    }

    void viewRooms() {
        line();
        cout << "                    ROOM STATUS\n";
        line();

        for (int i = 0; i < TOTAL_ROOMS; i++) {
            cout << "Room " << rooms[i].roomNumber
                 << " : ";

            if (rooms[i].occupied)
                cout << "Occupied (Patient "
                     << rooms[i].patientId << ")";
            else
                cout << "Available";

            cout << endl;
        }

        line();
    }

    void admitPatient() {
        int patientId = getInt("Patient ID: ");
        int roomNumber = getInt("Room Number: ");

        for (int i = 0; i < TOTAL_ROOMS; i++) {

            if (rooms[i].roomNumber == roomNumber) {

                if (rooms[i].occupied) {
                    cout << "Room already occupied!\n";
                    return;
                }

                rooms[i].occupied = true;
                rooms[i].patientId = patientId;

                cout << "Patient admitted to Room "
                     << roomNumber << ".\n";

                return;
            }
        }

        cout << "Room not found!\n";
    }

    void dischargePatient() {
        int roomNumber = getInt("Room Number: ");

        for (int i = 0; i < TOTAL_ROOMS; i++) {

            if (rooms[i].roomNumber == roomNumber) {

                if (!rooms[i].occupied) {
                    cout << "Room is already available.\n";
                    return;
                }

                rooms[i].occupied = false;
                rooms[i].patientId = -1;

                cout << "Patient discharged from room.\n";

                return;
            }
        }

        cout << "Room not found!\n";
    }

    int availableBeds() {
        int count = 0;

        for (int i = 0; i < TOTAL_ROOMS; i++) {
            if (!rooms[i].occupied)
                count++;
        }

        return count;
    }

    int occupiedBeds() {
        return TOTAL_ROOMS - availableBeds();
    }
};

